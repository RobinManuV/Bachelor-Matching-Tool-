# Base de datos (obligatorias en Netlify)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# Conexión PostgreSQL directa; solo se usa durante el build de Netlify.
SUPABASE_DB_URL=postgresql://postgres:CONTRASENA@db.TU_PROYECTO.supabase.co:5432/postgres

# Panel y correos de colegios
SITE_URL=https://TU-SITIO.netlify.app
RESEND_API_KEY=
RESEND_FROM=Project Robin <no-reply@project-robin.com>
APPLICATION_NOTIFY_EMAIL=hello@project-robin.com
# La usa el build para crear los tres accesos Robin si todavía no existen.
ROBIN_ADMIN_INITIAL_PASSWORD=

# Recomendaciones con IA (opcionales; sin ellas se usa el ranking determinista)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Solo para ejecutar el servidor local en otro puerto
PORT=3000
